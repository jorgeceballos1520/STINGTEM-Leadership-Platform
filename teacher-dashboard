<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>STING'EM Leadership Platform | Teacher Dashboard</title>
<style>
:root{--navy:#13263a;--navy2:#1d3955;--paper:#f5f2ea;--card:#fff;--line:#ddd8cf;--muted:#687789;--blue:#1e78b4;--green:#39734b;--red:#b94831;--gold:#c9a227;--gold2:#e3c24f;--shadow:0 12px 32px rgba(19,38,58,.10)}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--navy);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}.app{max-width:1100px;margin:auto;padding:18px 16px 60px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#111;color:#fff;padding:12px 14px;border-radius:14px;box-shadow:var(--shadow);margin-bottom:16px}.brand-logo{width:290px;max-width:48vw;height:auto;display:block}.top-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.btn{border:0;border-radius:10px;padding:10px 13px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.btn-gold{background:var(--gold);color:#111}.btn-gold:hover{background:var(--gold2)}.hero{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;border-radius:20px;padding:25px;box-shadow:var(--shadow);margin-bottom:16px}.hero h1{font-family:Georgia,serif;margin:0 0 5px;font-size:30px}.hero p{margin:0;color:#dbe4ec}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:19px;box-shadow:var(--shadow);margin-bottom:15px}.section-title{font-family:Georgia,serif;font-size:21px;margin:0 0 12px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.metric{border:1px solid var(--line);border-radius:13px;padding:15px;text-align:center;background:#fff}.metric .value{font-size:30px;font-weight:900}.metric .label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:800}.metric.approaches{border-top:5px solid var(--gold)}.metric.meets{border-top:5px solid var(--blue)}.metric.masters{border-top:5px solid var(--green)}.metric.notmeet{border-top:5px solid var(--red)}.meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}.meta-item{background:#faf9f5;border:1px solid var(--line);padding:11px;border-radius:10px}.meta-item b{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:3px}.period-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.period-card{border:1px solid var(--line);border-left:5px solid var(--blue);border-radius:12px;padding:14px}.period-card h3{margin:0 0 5px;font-size:16px}.small{font-size:12px;color:var(--muted)}.bar-wrap{margin-top:10px}.bar-row{display:grid;grid-template-columns:88px 1fr 46px;gap:8px;align-items:center;margin:7px 0;font-size:12px}.track{height:10px;background:#e9ecef;border-radius:999px;overflow:hidden}.fill{height:100%;border-radius:999px;background:var(--blue)}.fill.gold{background:var(--gold)}.fill.green{background:var(--green)}.analysis{display:grid;grid-template-columns:1fr 1fr;gap:12px}.analysis-box{padding:13px;border-radius:11px;background:#faf9f5;border:1px solid var(--line);white-space:pre-wrap}.analysis-box b{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:5px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left}th{text-transform:uppercase;color:var(--muted);font-size:10px}.status{padding:15px;border-radius:12px;margin-bottom:14px}.status.info{background:#eef7fc;color:#235a7c}.status.err{background:#f9e4dd;color:#7a2c1b}.empty{text-align:center;color:var(--muted);padding:24px}.hidden{display:none!important}@media(max-width:760px){.topbar{align-items:flex-start;flex-direction:column}.top-actions{width:100%}.top-actions .btn{flex:1}.metrics,.meta-grid,.analysis{grid-template-columns:1fr 1fr}.brand-logo{width:230px;max-width:70vw}}@media(max-width:500px){.metrics,.meta-grid,.analysis{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <img class="brand-logo" src="images/logo.png" alt="STING'EM Leadership Platform">
    <div class="top-actions"><a class="btn btn-gold" id="submitDataBtn" href="#">📝 Submit ET / Exam</a></div>
  </div>

  <section class="hero">
    <h1 id="teacherHeading">My Instructional Progress</h1>
    <p id="teacherSubheading">Loading your instructional data…</p>
  </section>

  <div id="statusBox" class="status info">Loading your submissions…</div>

  <div id="dashboardContent" class="hidden">
    <section class="card">
      <h2 class="section-title">Latest Submission</h2>
      <div class="metrics">
        <div class="metric approaches"><div class="value" id="approachesPct">0%</div><div class="label">Approaches+</div></div>
        <div class="metric meets"><div class="value" id="meetsPct">0%</div><div class="label">Meets+</div></div>
        <div class="metric masters"><div class="value" id="mastersPct">0%</div><div class="label">Masters</div></div>
        <div class="metric notmeet"><div class="value" id="notMeetCount">0</div><div class="label">Did Not Meet</div></div>
      </div>
      <div class="meta-grid">
        <div class="meta-item"><b>Date</b><span id="latestDate">—</span></div>
        <div class="meta-item"><b>Type</b><span id="latestType">—</span></div>
        <div class="meta-item"><b>Assessment</b><span id="latestAssessment">—</span></div>
        <div class="meta-item"><b>TEK</b><span id="latestTek">—</span></div>
      </div>
    </section>

    <section class="card"><h2 class="section-title">Performance by Period</h2><div id="periodGrid" class="period-grid"></div></section>

    <section class="card">
      <h2 class="section-title">Instructional Analysis</h2>
      <div class="analysis">
        <div class="analysis-box"><b>Misconceptions</b><span id="misconceptions">—</span></div>
        <div class="analysis-box"><b>Outcome</b><span id="outcome">—</span></div>
        <div class="analysis-box"><b>Causes</b><span id="causes">—</span></div>
        <div class="analysis-box"><b>Solutions / Next Steps</b><span id="solutions">—</span></div>
      </div>
    </section>

    <section class="card">
      <h2 class="section-title">Submission History</h2>
      <div style="overflow-x:auto">
        <table><thead><tr><th>Date</th><th>Type</th><th>Assessment</th><th>TEK</th><th>Approaches+</th><th>Meets+</th><th>Masters</th></tr></thead><tbody id="historyBody"></tbody></table>
      </div>
    </section>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
const firebaseConfig={
  apiKey:"AIzaSyA7nr506RwbSNZKFGPRKjb_qc_OFpgAhUM",
  authDomain:"idea-spears.firebaseapp.com",
  projectId:"idea-spears",
  storageBucket:"idea-spears.firebasestorage.app",
  messagingSenderId:"619672486663",
  appId:"1:619672486663:web:8672bb614d892ea00e7ba2",
  measurementId:"G-0SCW3PVT1D"
};

const TEACHERS_BY_ID={
  MTH601:{name:"T. Chow",course:"6th Math"},
  MTH701:{name:"A. Emenyonu",course:"7th Math"},
  MTH801:{name:"R. Raybon",course:"8th Math"},
  GEO901:{name:"G. Naves",course:"Geometry"},
  ALG101:{name:"L. Conkleton",course:"Algebra I & Algebra II"},
  PRECAL1:{name:"Vargas",course:"Pre-Calculus"},
  APSPAN1:{name:"L. Mosqueda",course:"AP Spanish"},
  PE001:{name:"R. Quiroz",course:"PE"},
  PE002:{name:"K. Waddell",course:"PE"},
  SPAN001:{name:"K. Abdullah",course:"Spanish I & Spanish II"}
};

if(!firebase.apps.length){firebase.initializeApp(firebaseConfig)}
const db=firebase.firestore();
const params=new URLSearchParams(window.location.search);
const teacherId=(params.get("id")||"").trim().toUpperCase();
const profile=TEACHERS_BY_ID[teacherId]||null;
const statusBox=document.getElementById("statusBox");
const dashboardContent=document.getElementById("dashboardContent");
const submitDataBtn=document.getElementById("submitDataBtn");

function pct(n,d){return d?Math.round((n/d)*100):0}
function safeText(v){return(v===undefined||v===null||v==="")?"—":String(v)}
function getMetrics(record){
  const t=record?.totals||{};
  const assessed=Number(t.assessed)||0, mastered=Number(t.mastered)||0, met=Number(t.met)||0, approached=Number(t.approached)||0, didNotMeet=Number(t.didNotMeet)||0;
  return{assessed,mastered,met,approached,didNotMeet,approachesPlus:pct(mastered+met+approached,assessed),meetsPlus:pct(mastered+met,assessed),masters:pct(mastered,assessed)};
}
function getPeriodMetrics(p){
  const assessed=Number(p.assessed)||0, mastered=Number(p.mastered)||0, met=Number(p.met)||0, approached=Number(p.approached)||0, didNotMeet=Number(p.didNotMeet)||0;
  return{assessed,mastered,met,approached,didNotMeet,approachesPlus:pct(mastered+met+approached,assessed),meetsPlus:pct(mastered+met,assessed),masters:pct(mastered,assessed)};
}

function renderLatest(record){
  const m=getMetrics(record);
  document.getElementById("approachesPct").textContent=m.approachesPlus+"%";
  document.getElementById("meetsPct").textContent=m.meetsPlus+"%";
  document.getElementById("mastersPct").textContent=m.masters+"%";
  document.getElementById("notMeetCount").textContent=m.didNotMeet;
  document.getElementById("latestDate").textContent=safeText(record.submissionDate);
  document.getElementById("latestType").textContent=safeText(record.submissionType);
  document.getElementById("latestAssessment").textContent=safeText(record.assessmentName);
  document.getElementById("latestTek").textContent=safeText(record.tekNumber);
  document.getElementById("misconceptions").textContent=safeText(record.misconceptions);
  document.getElementById("outcome").textContent=safeText(record.outcome);
  document.getElementById("causes").textContent=safeText(record.causes);
  document.getElementById("solutions").textContent=safeText(record.solutions);

  const periodGrid=document.getElementById("periodGrid"); periodGrid.innerHTML="";
  const periods=Array.isArray(record.periods)?record.periods:[];
  if(!periods.length){periodGrid.innerHTML='<div class="empty">No period data was included in this submission.</div>';return}
  periods.slice().sort((a,b)=>(Number(a.period)||0)-(Number(b.period)||0)).forEach(p=>{
    const pm=getPeriodMetrics(p), card=document.createElement("div"); card.className="period-card";
    card.innerHTML=`<h3>Period ${safeText(p.period)}</h3><div class="small">${safeText(p.objective)}</div><div class="small" style="margin-top:4px">${pm.assessed} students assessed</div><div class="bar-wrap"><div class="bar-row"><span>Approaches+</span><div class="track"><div class="fill gold" style="width:${pm.approachesPlus}%"></div></div><b>${pm.approachesPlus}%</b></div><div class="bar-row"><span>Meets+</span><div class="track"><div class="fill" style="width:${pm.meetsPlus}%"></div></div><b>${pm.meetsPlus}%</b></div><div class="bar-row"><span>Masters</span><div class="track"><div class="fill green" style="width:${pm.masters}%"></div></div><b>${pm.masters}%</b></div></div>`;
    periodGrid.appendChild(card);
  });
}

function renderHistory(records){
  const body=document.getElementById("historyBody"); body.innerHTML="";
  records.forEach(record=>{const m=getMetrics(record),tr=document.createElement("tr");tr.innerHTML=`<td>${safeText(record.submissionDate)}</td><td>${safeText(record.submissionType)}</td><td>${safeText(record.assessmentName)}</td><td>${safeText(record.tekNumber)}</td><td>${m.approachesPlus}%</td><td>${m.meetsPlus}%</td><td>${m.masters}%</td>`;body.appendChild(tr)});
}

async function loadTeacherDashboard(){
  if(!teacherId||!profile){
    statusBox.className="status err";
    statusBox.textContent="This teacher dashboard link is not recognized. Please use the personal link provided by Mr. Ceballos.";
    submitDataBtn.style.display="none";
    return;
  }
  document.getElementById("teacherHeading").textContent=`${profile.name} — My Instructional Progress`;
  document.getElementById("teacherSubheading").textContent=profile.course;
  submitDataBtn.href=`teacher-portal.html?id=${encodeURIComponent(teacherId)}`;

  try{
    const snap=await db.collection("instructionalSubmissions").where("teacherId","==",teacherId).get();
    const records=snap.docs.map(doc=>({id:doc.id,...doc.data()}));
    records.sort((a,b)=>{const ad=a.submissionDate||"",bd=b.submissionDate||"";if(ad!==bd)return bd.localeCompare(ad);const at=a.createdAt?.toMillis?.()||0,bt=b.createdAt?.toMillis?.()||0;return bt-at});
    if(!records.length){statusBox.className="status info";statusBox.innerHTML=`No instructional submissions are available yet. <a href="teacher-portal.html?id=${encodeURIComponent(teacherId)}">Submit your first Exit Ticket or Exam.</a>`;return}
    renderLatest(records[0]);renderHistory(records);statusBox.className="hidden";dashboardContent.classList.remove("hidden");
  }catch(err){console.error(err);statusBox.className="status err";statusBox.textContent="Your progress report could not be loaded. Firestore access may still need to be enabled for teacher dashboard viewing."}
}
loadTeacherDashboard();
</script>
</body>
</html>
